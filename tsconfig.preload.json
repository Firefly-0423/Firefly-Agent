{
  "compilerOptions": {
    "declaration": false,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "lib": [
      "ES2022",
      "DOM"
    ],
    "module": "commonjs",
    "outDir": "dist/preload",
    "resolveJsonModule": true,
    "rootDir": "src",
    "skipLibCheck": true,
    "sourceMap": true,
    "strict": true,
    "target": "ES2022"
  },
  "exclude": [
    "src/shared/renderer-base.ts",
    "src/**/*.test.ts"
  ],
  "include": [
    "src/preload/**/*.ts",
    "src/shared/**/*.ts"
  ]
}
