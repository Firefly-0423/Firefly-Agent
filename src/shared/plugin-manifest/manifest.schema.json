{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Firefly 1.2.0 plugin manifest (firefly.plugin.json)",
  "description": "Structural part of the manifest rules. SemVer, sdk range satisfaction, duplicate ids and package-boundary checks are done by validateManifest and firefly-plugin validate.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "name", "version", "sdk", "main"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(\\.[a-z0-9-]+){2,}$", "minLength": 6, "maxLength": 64 },
    "name": { "$ref": "#/definitions/nonBlank" },
    "version": { "type": "string", "minLength": 1 },
    "sdk": { "type": "string", "minLength": 1 },
    "description": { "$ref": "#/definitions/nonBlank" },
    "author": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "$ref": "#/definitions/nonBlank" },
        "email": { "$ref": "#/definitions/nonBlank" },
        "url": { "$ref": "#/definitions/nonBlank" }
      }
    },
    "license": { "$ref": "#/definitions/nonBlank" },
    "main": { "type": "string", "pattern": "\\.(mjs|cjs)$" },
    "icon": { "$ref": "#/definitions/nonBlank" },
    "platforms": {
      "type": "array",
      "minItems": 1,
      "items": { "enum": ["win32", "darwin", "linux"] }
    },
    "native": { "type": "boolean" },
    "tools": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "title", "risk", "modes"],
        "properties": {
          "name": { "$ref": "#/definitions/nonBlank" },
          "title": { "$ref": "#/definitions/nonBlank" },
          "risk": {
            "type": "array",
            "minItems": 1,
            "items": { "enum": ["fs-read", "fs-write", "shell", "network", "input-control"] }
          },
          "modes": {
            "type": "array",
            "minItems": 1,
            "items": { "enum": ["work", "code"] }
          }
        }
      }
    },
    "context": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "modes", "sources"],
        "properties": {
          "id": { "$ref": "#/definitions/nonBlank" },
          "title": { "$ref": "#/definitions/nonBlank" },
          "modes": {
            "type": "array",
            "minItems": 1,
            "items": { "enum": ["chat", "work", "code"] }
          },
          "sources": {
            "type": "array",
            "minItems": 1,
            "items": { "enum": ["user", "schedule", "plugin", "channel"] }
          }
        }
      }
    },
    "channels": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title"],
        "properties": {
          "id": { "$ref": "#/definitions/nonBlank" },
          "title": { "$ref": "#/definitions/nonBlank" }
        }
      }
    },
    "permissions": {
      "type": "array",
      "items": {
        "enum": ["model.generate", "model.run", "events", "sessions.read", "workspace.read", "schedules", "secrets", "ui.windows"]
      }
    },
    "ui": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "settings": {
          "type": "object",
          "additionalProperties": false,
          "required": ["entry", "title"],
          "properties": {
            "entry": { "$ref": "#/definitions/nonBlank" },
            "title": { "$ref": "#/definitions/nonBlank" }
          }
        },
        "windows": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "entry", "title"],
            "properties": {
              "id": { "$ref": "#/definitions/nonBlank" },
              "entry": { "$ref": "#/definitions/nonBlank" },
              "title": { "$ref": "#/definitions/nonBlank" },
              "width": { "type": "integer", "minimum": 1 },
              "height": { "type": "integer", "minimum": 1 }
            }
          }
        }
      }
    }
  },
  "definitions": {
    "nonBlank": { "type": "string", "pattern": "\\S" }
  }
}
