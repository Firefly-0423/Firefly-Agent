{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "lib": ["ES2022"],
    "outDir": "dist/main",
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": false,
    "sourceMap": true
  },
  "include": ["src/plugins/**/*.ts", "src/main/**/*.ts", "src/shared/**/*.ts"],
  "exclude": ["src/shared/renderer-base.ts", "src/**/*.test.ts", "src/**/*.acceptance.ts", "src/main/sim/**"]
}
