{
  "name": "firefly-agent",
  "version": "1.1.0",
  "packageManager": "npm@11.17.0",
  "description": "Firefly_Agent — 流萤桌面角色助手与 Agent 工作台",
  "author": "Firefly-0423",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Firefly-0423/Firefly-Agent.git"
  },
  "homepage": "https://github.com/Firefly-0423/Firefly-Agent",
  "bugs": {
    "url": "https://github.com/Firefly-0423/Firefly-Agent/issues"
  },
  "main": "dist/main/main/index.js",
  "bin": {
    "firefly": "./dist/cli/index.js"
  },
  "scripts": {
    "postinstall": "node scripts/security/node-forge-backport.mjs && node scripts/security/git-null-config-backport.mjs",
    "build:clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build:main": "npm run build:plugin-marketplace && node -e \"require('fs').rmSync('dist/main',{recursive:true,force:true})\" && tsc -p tsconfig.main.json && node -e \"const fs=require('fs');fs.cpSync('src/plugins','dist/main/plugins',{recursive:true,filter:s=>fs.statSync(s).isDirectory()||s.endsWith('manifest.json')||s.endsWith('manifest.schema.json')||s.endsWith('native-import.cjs')});fs.cpSync('src/main/plugin-panel','dist/main/main/plugin-panel',{recursive:true,filter:s=>fs.statSync(s).isDirectory()||s.endsWith('.js')});fs.cpSync('resources/plugin-marketplace','dist/main/plugin-marketplace',{recursive:true})\"",
    "generate:plugin-schema": "node scripts/plugin-sdk/generate-schema.mjs",
    "check:plugin-schema": "node scripts/plugin-sdk/generate-schema.mjs --check",
    "build:preload": "tsc -p tsconfig.preload.json",
    "check:renderer": "tsc -p tsconfig.renderer.json",
    "build:renderer": "vite build",
    "eval:memory-history": "node scripts/eval/memory-history/run.mjs",
    "test:eval": "node --test scripts/eval/memory-history/*.test.mjs",
    "perf:chat-baseline": "node scripts/perf/chat-renderer-baseline.mjs",
    "build:cli": "node scripts/build/cli.mjs",
    "build:screenshot-helper": "node scripts/build/screenshot-helper.mjs",
    "verify:screenshot-helper": "node scripts/verify/screenshot-helper.mjs resources/bin/firefly-screenshot.exe",
    "build:history-helpers": "node scripts/build/history-helpers.mjs",
    "verify:history-helpers": "node scripts/verify/history-helpers.mjs",
    "build:workspace-helper": "node scripts/build/workspace-helper.mjs",
    "verify:workspace-helper": "node scripts/verify/workspace-helper.mjs",
    "build": "npm run check:storage-boundary && npm run build:clean && npm run build:main && npm run build:preload && npm run build:cli && npm run build:renderer",
    "prepare:mingit": "node scripts/packaging/prepare-mingit.mjs",
    "validate:skills": "node scripts/packaging/validate-skills.mjs",
    "verify:installer": "node scripts/verify/history-helpers.mjs release/win-unpacked/resources/bin && node scripts/verify/workspace-helper.mjs release/win-unpacked/resources/bin && node scripts/verify/installer-artifacts.mjs",
    "package:win:dir": "npm run build && npm run build:screenshot-helper && npm run build:history-helpers && npm run verify:history-helpers && npm run build:workspace-helper && npm run verify:workspace-helper && npm run prepare:mingit && electron-builder --win --dir && npm run verify:workspace-helper -- release/win-unpacked/resources/bin && npm run verify:history-helpers -- release/win-unpacked/resources/bin",
    "package:win": "npm run build && npm run build:screenshot-helper && npm run build:history-helpers && npm run verify:history-helpers && npm run build:workspace-helper && npm run verify:workspace-helper && npm run prepare:mingit && electron-builder --win nsis --publish never && npm run verify:installer",
    "dev": "npm run build:main && npm run build:preload && npm run build:cli && concurrently \"vite\" \"cross-env VITE_DEV=1 electron . --firefly-profile=development\"",
    "start": "electron .",
    "check:storage-boundary": "node scripts/verify/storage-boundary.mjs",
    "test": "node scripts/testing/run-tests.mjs",
    "test:memory-history-zero-write": "vitest run --config scripts/testing/vitest.memory-history-zero-write.config.ts",
    "test:watch": "vitest",
    "smoke:music": "npm run build:main && node scripts/verify/music-smoke.mjs",
    "build:sim": "tsc -p tsconfig.sim.json",
    "sim": "tsc -p tsconfig.sim.json && node dist/sim/main/sim/dmae-sim.js",
    "sim:coffee": "tsc -p tsconfig.sim.json && node dist/sim/main/sim/dmae-sim.js --scenario=coffee",
    "sim:mix": "tsc -p tsconfig.sim.json && node dist/sim/main/sim/dmae-sim.js --scenario=mix",
    "sim:rescue": "tsc -p tsconfig.sim.json && node dist/sim/main/sim/dmae-sim.js --scenario=rescue",
    "sim:sweep": "tsc -p tsconfig.sim.json && node dist/sim/main/sim/dmae-sim.js --scenario=mix --rewardGain=3,5,7,10",
    "sim:l2": "tsc -p tsconfig.sim.json && node dist/sim/main/sim/run-l2-sim.js",
    "build:plugin-sdk": "node scripts/plugin-sdk/build-sdk.mjs",
    "check:plugin-sdk": "node scripts/plugin-sdk/build-sdk.mjs && node scripts/plugin-sdk/verify-package.mjs",
    "test:plugin-examples": "node scripts/plugin-sdk/test-examples.mjs",
    "build:plugin-marketplace": "node scripts/plugin-marketplace/build.mjs",
    "test:plugin-marketplace": "node --test scripts/plugin-marketplace/*.test.mjs"
  },
  "engines": {
    "node": ">=24 <25",
    "npm": ">=10"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/cross-spawn": "^6.0.6",
    "@types/diff": "^7.0.2",
    "@types/dompurify": "^3.0.5",
    "@types/js-yaml": "^4.0.9",
    "@types/pdfkit": "^0.17.6",
    "@types/qr-image": "^3.2.11",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.3.0",
    "@types/turndown": "^5.0.6",
    "@types/ws": "^8.18.1",
    "@types/yauzl": "3.4.0",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "9.2.3",
    "cross-env": "^7.0.3",
    "electron": "43.7.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.0",
    "jszip": "3.10.1",
    "playwright": "^1.63.0",
    "tailwindcss": "^4.3.3",
    "ts-json-schema-generator": "^1.5.1",
    "typescript": "^5.6.0",
    "vite": "7.3.6",
    "vitest": "^4.1.9"
  },
  "dependencies": {
    "@ag-ui/client": "^0.0.57",
    "@ag-ui/core": "^0.0.57",
    "@ant-design/icons": "^6.3.4",
    "@ant-design/x": "^2.9.0",
    "@anthropic-ai/sandbox-runtime": "^0.0.71",
    "@anthropic-ai/sdk": "^0.126.0",
    "@ast-grep/napi": "^0.45.1",
    "@larksuiteoapi/node-sdk": "1.71.1",
    "@modelcontextprotocol/sdk": "^1.31.0",
    "@node-rs/jieba": "^2.0.3",
    "@playwright/mcp": "0.0.79",
    "@streamdown/math": "^1.0.2",
    "@xenova/transformers": "^2.17.2",
    "ajv": "^8.20.0",
    "antd": "^6.6.4",
    "beautiful-mermaid": "^1.1.3",
    "chokidar": "^4.0.3",
    "cross-spawn": "^7.0.6",
    "diff": "^9.0.0",
    "docx": "^9.7.1",
    "dompurify": "3.4.16",
    "electron-updater": "^6.8.9",
    "exceljs": "^4.4.0",
    "i18next": "^26.4.0",
    "katex": "0.18.2",
    "lucide-react": "^1.32.0",
    "nodemailer": "10.0.15",
    "openai": "7.5.0",
    "package-manager-detector": "^1.8.0",
    "pdfkit": "^0.19.1",
    "pixi-live2d-display": "0.5.0-beta",
    "pixi.js": "^7.3.0",
    "qr-image": "^3.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.3.0",
    "react-resizable-panels": "^4.12.4",
    "rxjs": "^7.8.2",
    "shiki": "^4.3.1",
    "silk-wasm": "^3.7.1",
    "simple-git": "^4.0.2",
    "streamdown": "^2.6.0",
    "turndown": "^7.2.4",
    "unified": "^11.0.5",
    "vscode-jsonrpc": "^9.0.1",
    "vscode-languageserver-types": "^3.18.0",
    "ws": "^8.21.0",
    "yaml": "^2.9.0",
    "yauzl": "3.4.0",
    "@11ty/gray-matter": "3.0.0",
    "js-yaml": "5.4.3"
  },
  "overrides": {
    "@ag-ui/client": {
      "rxjs": "$rxjs"
    },
    "@hono/node-server": "1.19.15",
    "@xmldom/xmldom": "0.8.15",
    "axios": "1.20.0",
    "brace-expansion@^1": "1.1.21",
    "brace-expansion@^2": "2.1.7",
    "brace-expansion@^5": "5.0.12",
    "fast-uri": "3.1.8",
    "hono": "4.13.7",
    "ip-address": "10.7.1",
    "js-yaml@^3": "3.15.2",
    "js-yaml@^4": "4.3.2",
    "katex": "$katex",
    "mermaid": "11.16.1",
    "nanoid@^3": "3.3.18",
    "nanoid@^5": "5.1.16",
    "postcss": "8.5.23",
    "proxy-addr": "2.0.8",
    "protobufjs": "7.6.5",
    "qs": "6.16.0",
    "shell-quote": "1.11.0",
    "undici": "7.29.1",
    "jsdom": {
      "undici": "8.10.2"
    },
    "@xenova/transformers": {
      "sharp": "0.35.5"
    },
    "exceljs": {
      "uuid": "11.1.1"
    },
    "source-map-js": "1.2.2"
  },
  "allowScripts": {
    "protobufjs@7.6.5": true,
    "esbuild@0.28.2": true,
    "electron-winstaller@5.4.0": true,
    "tree-sitter@0.22.4": true,
    "electron@43.7.0": true,
    "sharp@0.35.5": true
  }
}
