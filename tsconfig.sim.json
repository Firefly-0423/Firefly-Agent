  "compilerOptions": {
    "declaration": false,
    "esModuleInterop": true,
    "module": "commonjs",
    "noImplicitAny": false,
    "outDir": "dist/sim",
    "resolveJsonModule": true,
    "rootDir": "src",
    "skipLibCheck": true,
    "strict": false,
    "target": "es2022"
  },
  "include": [
    "src/main/sim/**/*.ts",
    "src/main/rag/worldbook.ts"
  ]
}
