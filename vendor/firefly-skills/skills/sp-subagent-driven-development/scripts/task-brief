const fs = require("node:fs");
const path = require("node:path");
const workspace = require("./sdd-workspace");

try {
  if (process.argv.length !== 4 || !/^[1-9][0-9]*$/.test(process.argv[3])) throw new Error("USAGE: node task-brief PLAN_FILE TASK_NUMBER");
  const plan = process.argv[2];
  const number = process.argv[3];
  const lines = fs.readFileSync(plan, "utf8").split(/\r?\n/);
  const result = [];
  let fence = "";
  let active = false;
  for (const line of lines) {
    const marker = line.match(/^\s{0,3}(`{3,}|~{3,})/);
    if (!fence && marker) fence = marker[1];
    else if (fence && marker && marker[1][0] === fence[0] && marker[1].length >= fence.length) fence = "";
    else if (!fence) {
      const task = line.match(/^#{1,6}\s+Task\s+([1-9][0-9]*)\b/i);
      if (task) {
        if (active) break;
        active = task[1] === number;
      }
    }
    if (active) result.push(line);
  }
  if (!result.length) throw new Error("TASK_NOT_FOUND");
  const output = path.join(workspace(plan), "task-" + number + ".md");
  if (fs.existsSync(output) && fs.lstatSync(output).isSymbolicLink()) throw new Error("OUTPUT_LINK");
  fs.writeFileSync(output, result.join("\n") + "\n");
  console.log(output);
} catch (error) { console.error(error.message); process.exitCode = 1; }
