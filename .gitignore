# Native screenshot helper is built locally and staged for electron-builder.
resources/bin/*.exe

# mpv binary is downloaded locally and staged for electron-builder.
resources/bin/mpv/
.cache/mpv/

# Native gamebot（暂只有本地 Rust 构建产物 target/，暂不进 git）
native/*-gamebot/

# M0 POC scratch（含早期 token/qr.png 敏感产物，仅本地参考）
tmp-m0-poc/

# build/ 顶层是 NSIS 安装包的源资源（installer.nsh），
# 被 electron-builder.yml 引用，必须进 Git。
# build/installer/ui/ 是自研安装器 UI 的整个子项目，源码 + 产物都不进 git。
# 兜底：未来若在 build/ 下新增其他子目录（除了上方白名单文件），默认全部忽略。
build/*
!build/installer.nsh
build/installer/ui/
build/installer/ui/node_modules/
build/installer/ui/dist/
build/installer/ui/dist-electron/
build/installer/ui/dist-installer/
build/installer/ui/payload/
build/installer/ui/dev*.log

# Renderer 构建产物。产品资源的源码在 src/renderer/public/。
# 额外兜底：未跟踪的 context-usage 预览图与时间戳备份目录
dist/renderer/context-usage/
dist/renderer-old-*/
# music 播放器是本地构建产物（hash 文件名每次构建变化），不进 git
dist/renderer/music/
# toast 提醒窗口的 index.html 是 Vite 构建产物（引用 hash 文件名，每次构建变化），不进 git。
# 注：该窗口曾是唯一漏掉 ignore 的空窗，其他窗口的 index.html 均已在 lines 10-17 忽略。
dist/renderer/toast/index.html

# build/installer/ui/src/ 下的同名源图（setup/setup-loading/succeed/failed/ch）被安装 UI 引用，
# 打包时由 vite/webpack 复制到 src/renderer/react/assets/ 作为产物副本。
# 真正的源在 build/installer/ui/src/（已在上方 ignore），副本是构建输出，按文件名 ignore 避免误提交。
src/renderer/react/assets/ch.png
src/renderer/react/assets/failed.png
src/renderer/react/assets/setup.png
src/renderer/react/assets/setup-loading.png
src/renderer/react/assets/succeed.png

